# Server Port
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials
# Example: mongodb+srv://admin:MyPassword123@cluster0.abcde.mongodb.net/mern_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mern_db?retryWrites=true&w=majority

# Client URL for CORS
CLIENT_URL=http://localhost:3000
